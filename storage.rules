rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function roomData(roomCode) { return firestore.get(/databases/(default)/documents/rooms/$(roomCode)).data; }
    function isRoomMember(roomCode) {
      return signedIn() && (roomData(roomCode).hostUid == request.auth.uid || roomData(roomCode).guestUid == request.auth.uid);
    }
    match /rooms/{roomCode}/media/{uid}/{fileName} {
      allow read: if isRoomMember(roomCode);
      allow create: if isRoomMember(roomCode)
        && request.auth.uid == uid
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/(jpeg|png|webp|gif)') || request.resource.contentType.matches('audio/.*'));
      allow update, delete: if isRoomMember(roomCode) && request.auth.uid == uid;
    }
  }
}
