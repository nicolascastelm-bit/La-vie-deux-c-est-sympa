rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isHost(room) { return signedIn() && room.hostUid == request.auth.uid; }
    function isGuest(room) { return signedIn() && room.guestUid == request.auth.uid; }
    function isMember(room) { return isHost(room) || isGuest(room); }

    function coreFieldsUnchanged() {
      return request.resource.data.code == resource.data.code
        && request.resource.data.version == resource.data.version
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.mode == resource.data.mode
        && request.resource.data.scenarioId == resource.data.scenarioId
        && request.resource.data.targetCell == resource.data.targetCell;
    }

    function validGuestJoin() {
      return signedIn()
        && resource.data.status == 'waiting'
        && resource.data.guestUid == null
        && resource.data.players.guest == null
        && request.resource.data.guestUid == request.auth.uid
        && request.resource.data.players.guest.uid == request.auth.uid
        && request.resource.data.status == 'ready'
        && coreFieldsUnchanged();
    }

    match /rooms/{roomCode} {
      // Une salle en attente peut être lue avec son code secret afin de la rejoindre.
      // Après le démarrage, seuls ses deux membres peuvent la lire.
      allow read: if signedIn() && (resource.data.status == 'waiting' || isMember(resource.data));

      allow create: if signedIn()
        && request.resource.data.code == roomCode
        && request.resource.data.version == 10
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.players.host.uid == request.auth.uid
        && request.resource.data.guestUid == null
        && request.resource.data.targetCell in [36, 49, 63];

      allow update: if validGuestJoin()
        || (isMember(resource.data) && coreFieldsUnchanged());

      allow delete: if isHost(resource.data);
    }
  }
}
